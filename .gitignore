# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Personal data uploaded through the control panel (never committed)
jobfit/data/cvs/
jobfit/data/connections.csv
jobfit/data/referrals/
jobfit/data/profiles.json
jobfit/data/.server.lock

# Job detail-page TTL cache (jobfit/scrape) - regeneratable, not committed
# like data/scrape_plans/ and cache/listing_snapshots/ are.
jobfit/cache/pages/
# URL-audit progress (resumable check_urls run) - transient.
jobfit/cache/url_check_progress.json
# Per-company flatten cache for aggregate_to_jobs_v2 - regeneratable.
jobfit/cache/aggregate/
# Cross-process pipeline lock - exists only while a stage is running.
jobfit/data/.pipeline.lock
# Playwright MCP session snapshots/logs.
.playwright-mcp/

# Personal Claude Code overrides (see CLAUDE.local.md.example).
CLAUDE.local.md

# Transient run logs from a manual update.
jobfit/cache/*.log
jobfit/cache/*.log.out

# SQLite store - the source of truth for job data, rebuilt by a scrape.
jobfit/data/jobfit.db
jobfit/data/jobfit.db-wal
jobfit/data/jobfit.db-shm

# Front end: dependencies and the intermediate build. The BUILT app under
# jobfit/server/static/app/ is committed, so the server needs no Node.
frontend/node_modules/
frontend/dist/

# Superseded by the SQLite store (jobfit/data/jobfit.db). Untracked rather than
# deleted: they are the rollback path the migration already needed once, and
# they stay recoverable from git history either way.
jobfit/companies/
jobfit/companies_career_pages.json
jobfit/data/company_review.json
jobfit/data/company_registry.json
jobfit/data/jobs_v2.json
jobfit/data/jobs_v2.meta.json
